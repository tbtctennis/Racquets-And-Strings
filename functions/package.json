{
  "name": "functions",
  "description": "Cloud Functions for Racquets & Strings",
  "private": true,
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "scripts": {
    "build:ts": "node ../scripts/run-with-pinned-node.mjs -- ../node_modules/typescript/bin/tsc -p tsconfig.json && node ../scripts/run-with-pinned-node.mjs -- ../node_modules/prettier/bin/prettier.cjs --write lib/callable.js lib/logging.js",
    "typecheck": "node ../scripts/run-with-pinned-node.mjs -- ../node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
    "test": "npm run typecheck && node ../scripts/run-with-pinned-node.mjs -- --test test/*.test.js"
  },
  "dependencies": {
    "@google-cloud/bigquery": "^7.9.0",
    "@google-cloud/vision": "^4.3.0",
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^7.3.2",
    "googleapis": "^173.0.0",
    "resend": "^3.2.0"
  }
}
