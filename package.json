{
  "name": "racquets-and-strings",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.23.2"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "node scripts/run-with-pinned-node.mjs -- scripts/build-programs-csv.mjs && node scripts/run-with-pinned-node.mjs -- node_modules/vite/bin/vite.js build",
    "build:programs": "node scripts/run-with-pinned-node.mjs -- scripts/build-programs-csv.mjs",
    "preview": "vite preview",
    "dev:emulator": "node scripts/run-with-pinned-node.mjs -- scripts/start-emulators.mjs",
    "emulators": "node scripts/run-with-pinned-node.mjs -- scripts/start-emulators.mjs",
    "test:rules": "node scripts/run-with-pinned-node.mjs -- scripts/run-emulator-test.mjs firestore",
    "test:storage": "node scripts/run-with-pinned-node.mjs -- scripts/run-emulator-test.mjs storage",
    "test": "node scripts/run-with-pinned-node.mjs -- --import tsx --test tests/unit/*.test.mjs",
    "seed:emulator": "node scripts/run-with-pinned-node.mjs -- tests/fixtures/seed-emulator.mjs",
    "test:fixtures": "node scripts/run-with-pinned-node.mjs -- scripts/run-emulator-fixture-test.mjs",
    "test:functions:integration": "node scripts/run-with-pinned-node.mjs -- scripts/run-functions-integration-test.mjs",
    "test:e2e": "node scripts/run-with-pinned-node.mjs -- scripts/run-browser-e2e.mjs",
    "hosting:deploy": "npm run build && node scripts/deploy-hosting.mjs deploy",
    "hosting:preview": "npm run build && node scripts/deploy-hosting.mjs preview",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "node scripts/run-with-pinned-node.mjs -- --max-old-space-size=3072 ./node_modules/typescript/bin/tsc --noEmit",
    "lint": "node scripts/run-with-pinned-node.mjs -- node_modules/eslint/bin/eslint.js src scripts tests functions --report-unused-disable-directives",
    "format": "node scripts/run-prettier.mjs write",
    "format:check": "node scripts/run-with-pinned-node.mjs -- scripts/run-prettier.mjs check",
    "docs:verify": "node scripts/run-with-pinned-node.mjs -- scripts/verify-docs.mjs",
    "design:verify": "node scripts/run-with-pinned-node.mjs -- scripts/verify-design-d3.mjs",
    "functions:syntax": "node scripts/run-with-pinned-node.mjs -- scripts/check-functions-syntax.mjs",
    "migrations:example": "node scripts/migrations/001-example.mjs",
    "migrations:event-type-casing": "node scripts/migrations/002-event-type-casing.mjs",
    "migrations:event-draw-hiding": "node scripts/migrations/003-event-draw-hiding.mjs",
    "migrations:provider-role": "node scripts/migrations/004-provider-role.mjs",
    "verify": "node scripts/run-with-pinned-node.mjs -- scripts/verify.mjs",
    "dataset:build": "node scripts/build-sample-dataset.mjs",
    "seed:dataset": "node tests/fixtures/seed-dataset.mjs",
    "dataset:xlsx": "node scripts/export-dataset-xlsx.mjs"
  },
  "dependencies": {
    "@intl-tel-input/react": "^29.1.2",
    "clsx": "^2.1.1",
    "exifr": "^7.1.3",
    "firebase": "^12.17.1",
    "lucide-react": "^0.546.0",
    "mailcheck": "^1.1.1",
    "maplibre-gl": "^5.24.0",
    "motion": "^12.38.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-map-gl": "^8.1.1",
    "react-router-dom": "^7.14.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "firebase-admin": "^13.10.0",
    "firebase-tools": "15.27.0",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "8.67.0",
    "vite": "^6.2.0"
  }
}
